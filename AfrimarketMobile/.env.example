# =====================================================================
#  AFRI MARKET (app EXPO) — variables d'environnement
#  Copie ce fichier vers .env  puis remplis les valeurs.
#  (Expo lit nativement les variables préfixées EXPO_PUBLIC_ au runtime.)
# =====================================================================

# --- SERVEUR DE PAIEMENT (Render) ------------------------------------
# 1) Déploie le dossier server/ sur Render en 1 clic (voir README § Déploiement).
#    render.yaml est déjà à la racine du dépôt Git → Render génère une URL.
# 2) Colle ICI l'URL obtenue (ex: https://afrimarket-server-xxxx.onrender.com)
#    SANS slash final. Sans cette URL, l'app reste en paiement simulé local.
EXPO_PUBLIC_PAYMENT_SERVER_URL=https://afrimarket-server-xxxx.onrender.com

# --- SUPABASE (base de données & prix produits) -----------------------
# Renseigne si tu veux que le téléphone affiche/contrôle des données
# synchronisées (boutiques, produits, prix réels) via Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
