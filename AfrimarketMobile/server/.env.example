# ---- AFRI MARKET : serveur de paiement CinetPay ----

# Port du serveur (par defaut 4000).
PORT=4000

# --- MODE REEL : renseigner ces cles CinetPay (API v1) ---
# Sans ces cles, le serveur fonctionne en MODE MOCK
# (OTP genere localement et retourne pour les tests).
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Echappatoire de developpement uniquement : autorise un panier vide
# (montant non verifiable). NE JAMAIS activer en production.
MOCK_ALLOW_EMPTY_BASKET=false
# Pays du compte marchand (BF = Burkina Faso)
CINETPAY_COUNTRY=BF
# Base de l'API CinetPay (ne pas toucher en general)
CINETPAY_API_BASE=https://api.cinetpay.net

# --- Legacy CHECKOUT (apikey/site_id) : pour le HMAC du webhook ---
# CINETPAY_SECRET_KEY=

# --- Source de verite des prix (lecture seule via cle publique) ---
SUPABASE_URL=https://acxbdhdpmdasrdxwllgi.supabase.co
SUPABASE_ANON_KEY=sb_publishable_gyQKxL1C-D6l-phEOD7d3g_A2Ac1sG4
# Cle service_role : COTE SERVEUR UNIQUEMENT, jamais dans l'app ni dans git.
# Utilisee par scripts/seed-products.js pour creer boutique + produits de demo.
SUPABASE_SERVICE_ROLE_KEY=
# Table des codes promo valides cote serveur (les remises ne sont plus
# chiffrees par l'app : le serveur les recalcule depuis cette table).
SUPABASE_TABLE_COUPONS=coupons
# Plafond serveur d'une ligne de frais (livraison/frais/port/taxes).
MAX_FEE_PER_LINE=10000

# --- Notifications push (Expo) ---
# Cle partagee avec l'app pour /api/push/register et /api/push/notify.
PUSH_API_KEY=afrimarket-demo-push
# Admin : token requis sur GET /api/pay/transactions (en-tete x-admin-token)
# ADMIN_TOKEN=afrimarket-demo-admin

# --- Synchronisation multi-appareils (beta) ---
# Aucune cle requise pour demarrer : chaque compte recoit un secret lors de
# /api/sync/register (stocke hache). Serveur : POST /api/sync/register,
# /api/sync/put, GET /api/sync/pull ; debug : GET /api/sync/status (admin).